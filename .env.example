# =============================================================================
# CodePilot Root Environment Configuration Example
# Copy to .env and fill in real values before running Docker Compose.
# Never commit .env files or real secrets.
# =============================================================================

# --- Host Ports (change if 3000 or 8080 are already in use) ---
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8080

# --- PostgreSQL (containerized via Docker Compose; local EDB 5432 untouched) ---
POSTGRES_DB=codepilot
POSTGRES_USER=codepilot
POSTGRES_PASSWORD=change-me-postgres-password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- Redis (containerized via Docker Compose; local Homebrew Redis untouched) ---
REDIS_USERNAME=
REDIS_PASSWORD=

# --- GitHub OAuth & Webhooks ---
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret

# --- Google Gemini AI ---
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com
GEMINI_API_MODEL=gemini-3-flash-preview
GEMINI_CONNECT_TIMEOUT_MS=5000
GEMINI_READ_TIMEOUT_MS=45000

# --- Security & Encryption ---
# Must be a 64-character hex string (32 bytes / 256-bit AES-GCM key).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-char-encryption-key
# Optional comma-separated previous keys for zero-downtime key rotation:
ENCRYPTION_PREVIOUS_KEYS=
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Browser-facing backend origin baked into the Next.js build:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Production recommendation: COOKIE_SECURE=true, COOKIE_SAME_SITE=Lax (or None over HTTPS cross-site)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
SESSION_TIMEOUT=30m
CODEPILOT_SWAGGER_PUBLIC=false
ACTUATOR_HEALTH_SHOW_DETAILS=never

# --- Review Engine & Publishing ---
CODEPILOT_REVIEW_PUBLISH_COMMENTS_ENABLED=false
CODEPILOT_REVIEW_MAX_FILE_BYTES=102400
CODEPILOT_REVIEW_MAX_DIFF_BYTES=2097152
CODEPILOT_REVIEW_MAX_ATTEMPTS=3
CODEPILOT_REVIEW_ASYNC_ENABLED=true

