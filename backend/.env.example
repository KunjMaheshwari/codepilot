# =============================================================================
# CodePilot Backend Standalone Environment Configuration Example
# Use when running the Spring Boot backend directly outside Docker Compose.
# =============================================================================

DB_URL=jdbc:postgresql://localhost:5432/codepilot
DB_USERNAME=codepilot
DB_PASSWORD=change-me-postgres-password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com
GEMINI_API_MODEL=gemini-2.5-flash

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
SESSION_TIMEOUT=30m
CODEPILOT_SWAGGER_PUBLIC=false
ACTUATOR_HEALTH_SHOW_DETAILS=never

CODEPILOT_REVIEW_PUBLISH_COMMENTS_ENABLED=false
CODEPILOT_REVIEW_MAX_FILE_BYTES=102400
CODEPILOT_REVIEW_MAX_DIFF_BYTES=2097152
CODEPILOT_REVIEW_MAX_ATTEMPTS=3
CODEPILOT_REVIEW_ASYNC_ENABLED=true

